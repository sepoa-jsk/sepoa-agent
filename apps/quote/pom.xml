<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    세포아소프트 견적 자동화 시스템 — Java 이식 (J1 스캐폴딩)

    Spring Boot 는 3.5.3 으로 고정한다. start.spring.io 는 현재 4.x 만 제공하지만
    docs/WBS-java.md 가 3.x 를 전제로 작성돼 있어 그대로 따랐다. Maven Wrapper 만
    Initializr 산출물에서 가져왔다(러너는 Boot 버전과 무관하다).

    의존성은 J1 최소 구성이다. security · oauth2 · flyway · thymeleaf · poi 는
    각각 J8 · J8 · J4 · J7 · J7 에서 추가한다. 지금 넣지 않는다.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>kr.co.sepoasoft</groupId>
  <artifactId>quote-automation</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>war</packaging>
  <name>quote-automation</name>
  <description>세포아소프트 견적 자동화 시스템 (Java 이식)</description>

  <properties>
    <java.version>17</java.version>
    <!--
      실측 픽스처 정본 위치. J2 시점에는 Node 쪽에 있다.
      quote/ 를 삭제할 때 src/test/resources/fixtures 로 옮기고 위 복사 plugin 을 지운다.
    -->
    <measured.fixtures.dir>${project.basedir}/../quote-legacy/test/fixtures</measured.fixtures.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 노임단가표(PDF) 업로드 — 문서의 표를 글자로 읽어 단가를 채운다 -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.5</version>
    </dependency>

    <!--
      Flyway (J4) — 자체 러너(db/migrate.js) 대체.
      flyway-mysql 은 MySQL/MariaDB 방언 모듈이며 flyway-core 만으로는 MariaDB 를 인식하지 못한다.

      ⚠️ 개발 DB 를 Node 앱과 공유 중이다. dev 프로파일에서 spring.flyway.enabled=false 로
      자동 실행을 막는다. 근거는 application-dev.yml 주석 참조.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!--
      외부 Tomcat 에 WAR 로 배포하므로 내장 Tomcat 은 provided 로 둔다.
      이 스코프가 틀리면 WAR 는 정상 생성되는데 외부 Tomcat 에서 뜨지 않는다
      (컨테이너와 클래스가 충돌한다). 빌드 후 WEB-INF/lib 에 tomcat-embed-* 가
      없는지 반드시 확인할 것 — docs/README.md 의 검증 절차 참조.
      provided 라도 mvnw spring-boot:run 은 정상 동작한다.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      tomcat-embed-el 을 명시적으로 provided 로 내린다.

      spring-boot-starter-validation 이 이것을 compile 스코프로 끌어오기 때문에,
      starter-tomcat 쪽 provided 선언이 있어도 compile 이 이겨 WEB-INF/lib 에 들어간다
      (직접 선언이 전이 의존성보다 우선하므로 여기서 덮는다).

      실제로 J1 첫 빌드에서 WEB-INF/lib/tomcat-embed-el-10.1.42.jar 이 포함된 것을 확인했다.
      외부 Tomcat 은 자기 EL 구현을 lib/ 에 가지고 있어 클래스가 중복된다.
      Tomcat 10.1 이 Jakarta EL 5.0 을 제공하므로 Hibernate Validator 8 은 그것을 쓴다.

      주의: EL 을 제공하지 않는 컨테이너에 배포하면 검증 메시지 보간이 런타임에 깨진다.
      J9 에서 대상 Tomcat 버전을 확인할 것(10.1 이상이어야 한다).
    -->
    <dependency>
      <groupId>org.apache.tomcat.embed</groupId>
      <artifactId>tomcat-embed-el</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- JUnit 5 · AssertJ · Jackson 이 전부 들어 있다 (Boot BOM 이 버전 관리) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!--
      WAR 파일명을 quote2 로 고정한다. 외부 Tomcat 은 WAR 파일명이 context path 를
      정하므로 quote2.war → /quote2 가 된다. Node 앱의 /quote 와 병행 운영하기 위한 것이며
      J5 병행 대조에 쓴다.
    -->
    <finalName>quote2</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        실측 픽스처를 테스트 클래스패스로 복사한다.

        픽스처 정본은 ../quote-legacy/test/fixtures/ 한 곳뿐이다. Node 테스트와 Java 테스트가
        같은 파일을 읽어야 두 구현 대조가 성립하므로 사본을 커밋하지 않는다.
        여기서 만드는 복사본은 target/ 안에만 생기며 gitignore 대상이다.

        상대경로로 직접 읽지 않는 이유: quote/ 는 J2 완료 후 삭제된다. 그때 픽스처를
        src/test/resources/fixtures/ 로 옮기고 이 plugin 블록만 지우면 되고,
        테스트 코드는 한 줄도 바뀌지 않는다.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-measured-fixtures</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.testOutputDirectory}/fixtures</outputDirectory>
              <resources>
                <resource>
                  <directory>${measured.fixtures.dir}</directory>
                  <includes><include>**/*.json</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
