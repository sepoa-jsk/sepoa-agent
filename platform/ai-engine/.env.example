# 내부 AI 엔진 설정. 이 파일을 .env 로 복사해 쓴다 (.env 는 커밋하지 않는다).

# 업무 앱(Java)이 호출할 때 X-Internal-Token 헤더로 보내는 값. 비어 있으면 기동을 거부한다.
AI_ENGINE_TOKEN=change-me

# LLM 호출 방식 — stub: API 키 없이 고정 응답(개발·테스트용) / anthropic: 실제 호출
LLM_MODE=stub
ANTHROPIC_API_KEY=
# 기본 모델. 작업별로 options.model 로 덮어쓸 수 있다.
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=2048
